<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.julian.garmin-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/julianjelfs/work/garmin_mcp/sync.sh</string>
    </array>

    <!-- Run daily at 06:00 local. launchd runs it at next wake if asleep. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/julianjelfs/work/garmin_mcp/sync.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/julianjelfs/work/garmin_mcp/sync.launchd.log</string>
</dict>
</plist>
