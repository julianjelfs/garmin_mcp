<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.julian.garmin-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/julianjelfs/work/garmin_mcp/sync.sh</string>
    </array>

    <!-- Runs twice daily local: 06:00 catches overnight activities early; 14:00
         re-runs after the watch has synced and Garmin has finalized the night's
         sleep score + training readiness (both are stubs at 06:00). The importer
         is idempotent (INSERT OR REPLACE), so the afternoon run backfills them.
         launchd runs any missed interval at next wake. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/julianjelfs/work/garmin_mcp/sync.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/julianjelfs/work/garmin_mcp/sync.launchd.log</string>
</dict>
</plist>
